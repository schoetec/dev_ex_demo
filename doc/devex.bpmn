  <bpmn:process id="DevExCICDProcess" name="DevEx CI/CD Process" isExecutable="false">
    <bpmn:serviceTask id="Task_TriggerWorkflow" name="Trigger GitHub Actions workflow">
      <bpmn:incoming>Flow_0isyxta</bpmn:incoming>
      <bpmn:outgoing>Flow_Trigger_Build</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BuildDockerImage" name="Build Docker image">
      <bpmn:categoryValueRef>CategoryValue_0boyn86</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_02q68hr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RunTests" name="Run tests in container">
      <bpmn:categoryValueRef>CategoryValue_0boyn86</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Trigger_Build</bpmn:incoming>
      <bpmn:outgoing>Flow_1f30waq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_TestsPassed" name="Tests passed?" default="Flow_Fail">
      <bpmn:categoryValueRef>CategoryValue_0boyn86</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1f30waq</bpmn:incoming>
      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_NotifyFailure" name="Notify: build failed">
      <bpmn:categoryValueRef>CategoryValue_0boyn86</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Fail</bpmn:incoming>
      <bpmn:incoming>Flow_06jsmju</bpmn:incoming>
      <bpmn:outgoing>Flow_Fail_End</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_Failure" name="Pipeline failed">
      <bpmn:categoryValueRef>CategoryValue_0boyn86</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Fail_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_PublishCloudsmith" name="Publish image to Cloudsmith">
      <bpmn:categoryValueRef>CategoryValue_0boyn86</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_02q68hr</bpmn:incoming>
      <bpmn:outgoing>Flow_Publish_Deploy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Success" name="App deployed">
      <bpmn:incoming>Flow_Deploy_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Trigger_Build" sourceRef="Task_TriggerWorkflow" targetRef="Task_RunTests" />
    <bpmn:sequenceFlow id="Flow_Pass" name="yes" sourceRef="Gateway_TestsPassed" targetRef="Task_BuildDockerImage">
      <bpmn:categoryValueRef>CategoryValue_0boyn86</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Fail" name="no" sourceRef="Gateway_TestsPassed" targetRef="Event_NotifyFailure">
