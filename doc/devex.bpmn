    <bpmn:sequenceFlow id="Flow_Publish_Deploy" sourceRef="Task_PublishCloudsmith" targetRef="Task_DeployContainer" />
    <bpmn:sequenceFlow id="Flow_Deploy_End" sourceRef="Task_DeployContainer" targetRef="End_Success" />
